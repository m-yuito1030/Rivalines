# Caddy automatically obtains and renews the HTTPS certificates (DNS must point to the VPS and 80/443 must be open)
{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
		# Pass the screen, API, and WebSocket (/ws) all to web (nginx). The source IP is conveyed in X-Forwarded-For
	reverse_proxy rivalines-web:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
