# A template for the VPS .env (cp .env.example .env and edit. Never put .env in git)
# The port to open to the outside (pick a number that does not clash with existing services)
WEB_PORT=8092
# If HTTPS is left to another proxy in front, use 127.0.0.1 so it cannot be opened directly from outside
WEB_BIND=0.0.0.0
# Needed only when using --profile https (Caddy)
DOMAIN=rivalines.com
# For operators. Make it a long random string (e.g. openssl rand -hex 24)
ADMIN_KEY=
# Max concurrent connections (about 100 is a guide for 4 GB of memory)
MAX_ONLINE=100
REGISTER_PER_HOUR=300
# Game speed (1 = one game day per 30 real minutes. 0.5 = one day per 60 minutes)
SPEED=0.5
