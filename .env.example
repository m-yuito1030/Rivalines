# VPS の .env の雛形(cp .env.example .env して書き換える。.env は git に入れない)
# 外に開けるポート(既存のサービスとぶつからない番号にする)
WEB_PORT=8092
# HTTPS を手前の別のプロキシに任せたら、127.0.0.1 にして外から直接開けないようにする
WEB_BIND=0.0.0.0
# --profile https(Caddy)を使うときだけ必要
DOMAIN=rivalines.com
# 運営用。長いランダムな文字列にする(例: openssl rand -hex 24)
ADMIN_KEY=
# 同時に接続できる人数(メモリ 4GB なら 100 が目安)
MAX_ONLINE=100
REGISTER_PER_HOUR=300
# ゲームの進む速さ(1 = 実時間30分でゲーム内1日。0.5 = 60分で1日)
SPEED=0.5
